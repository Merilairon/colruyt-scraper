{
  "name": "node-express-web-ts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "debug": "npm run build && npm run start",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:gtin": "node dist/scripts/seedGtin.js",
    "test": "jest --forceExit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs"
          }
        }
      ]
    }
  },
  "scarfSettings": {
    "enabled": false
  },
  "overrides": {
    "uuid": "11.1.1",
    "test-exclude": ">=8.0.0",
    "glob": "^11.1.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.18.0",
    "body-parser": "^2.2.2",
    "cli-progress": "^3.12.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-cache-headers": "^0.1.4",
    "fuse.js": "^7.1.0",
    "https-proxy-agent": "^7.0.6",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "quick-lru": "^7.3.0",
    "sequelize": "^6.37.8",
    "socks-proxy-agent": "^8.0.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/memory-cache": "^0.2.6",
    "@types/node": "^22.17.1",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  }
}
